/* ═══════════════════════════════════════════════════════════════
   ŪRDHV ASCENS — Content Hydrator
   API-Hydration Engine for Dynamic Content Binding
   ═══════════════════════════════════════════════════════════════ */

class ContentHydrator {
    /**
     * @param {Object} config
     * @param {string} config.apiBase - Base URL for API endpoints (e.g., '/api')
     * @param {boolean} config.debug - Enable console logging
     */
    constructor(config = {}) {
        this.apiBase = config.apiBase || '/api';
        this.debug = config.debug || false;
        this.cache = new Map();
    }

    /**
     * Initialize hydration — scan DOM and fetch data
     */
    async init() {
        this.log('Hydrator initialized');

        try {
            await this.loadGlobalContent();
            this.log('Global content loaded');
        } catch (err) {
            this.log('API unavailable — using static fallback content', 'warn');
        }

        // Auto-discover and render any data-api-list containers
        const listContainers = document.querySelectorAll('[data-api-list]');
        for (const container of listContainers) {
            const endpoint = container.getAttribute('data-api-list');
            const templateId = container.getAttribute('data-template');
            if (endpoint && templateId) {
                try {
                    await this.renderList(container.id, templateId, endpoint);
                } catch (err) {
                    this.log(`Failed to load list: ${endpoint}`, 'warn');
                }
            }
        }
    }

    /**
     * Fetch and apply global key-value content from site_content table
     */
    async loadGlobalContent() {
        let loaded = false;

        // Try API first
        try {
            const url = `${this.apiBase}/read?table=site_content`;
            const response = await fetch(url);

            if (!response.ok) {
                throw new Error(`API error: ${response.status}`);
            }

            const data = await response.json();

            if (!data || !data.success) {
                throw new Error('Invalid API response');
            }

            const items = data.data || data;

            // Map response: [{key_name: "hero_heading", value_content: "Welcome"}]
            (Array.isArray(items) ? items : []).forEach(item => {
                const keyName = item.key_name;
                const value = item.value_content;

                if (!keyName) return;

                // Cache the value
                this.cache.set(keyName, value);

                // Find all elements bound to this key
                const elements = document.querySelectorAll(`[data-api-key="${keyName}"]`);
                elements.forEach(el => {
                    this.applyValue(el, value);
                });
            });

            loaded = true;
        } catch (err) {
            this.log('API unavailable, trying localStorage fallback', 'warn');
        }

        // Fallback: read from localStorage (matches admin save format: content_<key>)
        if (!loaded) {
            const apiElements = document.querySelectorAll('[data-api-key]');
            apiElements.forEach(el => {
                const key = el.getAttribute('data-api-key');
                const saved = localStorage.getItem(`content_${key}`);
                if (saved) {
                    this.cache.set(key, saved);
                    this.applyValue(el, saved);
                }
            });
            this.log(`Loaded ${apiElements.length} elements from localStorage fallback`);
        }
    }

    /**
     * Render a list of items into a container using a template
     * @param {string} containerId - ID of the container element
     * @param {string} templateId - ID of the <template> element
     * @param {string} endpoint - Table/endpoint name
     */
    async renderList(containerId, templateId, endpoint) {
        const url = `${this.apiBase}/read?table=${endpoint}`;
        const response = await fetch(url);

        if (!response.ok) {
            throw new Error(`API error: ${response.status}`);
        }

        const data = await response.json();
        const items = data.data || data;

        const container = document.getElementById(containerId);
        const template = document.getElementById(templateId);

        if (!container || !template) {
            this.log(`Container #${containerId} or template #${templateId} not found`, 'warn');
            return;
        }

        // Clear existing content
        container.innerHTML = '';

        (Array.isArray(items) ? items : []).forEach(item => {
            const clone = document.importNode(template.content, true);

            // Find all internal bind points
            clone.querySelectorAll('[data-bind]').forEach(el => {
                const key = el.getAttribute('data-bind');
                const value = item[key];
                if (value !== undefined) {
                    this.applyValue(el, value);
                }
            });

            container.appendChild(clone);
        });

        this.log(`Rendered ${items.length} items into #${containerId}`);
    }

    /**
     * Apply a value to an element, handling different element types
     * @param {HTMLElement} el
     * @param {string} value
     */
    applyValue(el, value) {
        // Check for explicit attribute binding
        const attr = el.getAttribute('data-attr');
        if (attr) {
            el.setAttribute(attr, value);
            return;
        }

        // If element has data-counter, update the counter target too
        if (el.hasAttribute('data-counter')) {
            el.setAttribute('data-counter', value);
        }

        // Handle different element types
        switch (el.tagName) {
            case 'IMG':
                el.src = value;
                break;
            case 'INPUT':
            case 'TEXTAREA':
                el.value = value;
                break;
            case 'A':
                if (!el.hasAttribute('data-attr')) {
                    el.textContent = value;
                }
                break;
            default:
                // For elements with HTML content support
                if (el.hasAttribute('data-html')) {
                    el.innerHTML = value;
                } else {
                    el.textContent = value;
                }
        }
    }

    /**
     * Get a cached value by key
     * @param {string} key
     * @returns {string|undefined}
     */
    getValue(key) {
        return this.cache.get(key);
    }

    /**
     * Debug logger
     */
    log(message, level = 'info') {
        if (this.debug) {
            const prefix = '🔹 [Hydrator]';
            if (level === 'warn') {
                console.warn(`${prefix} ${message}`);
            } else if (level === 'error') {
                console.error(`${prefix} ${message}`);
            } else {
                console.log(`${prefix} ${message}`);
            }
        }
    }
}

// ─── Auto-Initialize ───
// Only attempt hydration if we detect an API base URL or data-api elements exist
(function () {
    const hasApiElements = document.querySelector('[data-api-key]') ||
        document.querySelector('[data-api-list]');

    if (hasApiElements) {
        const hydrator = new ContentHydrator({
            apiBase: '/api',
            debug: false
        });

        // Attempt hydration after DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => hydrator.init());
        } else {
            hydrator.init();
        }

        // Expose globally for use in admin or custom scripts
        window.hydrator = hydrator;
    }
})();
